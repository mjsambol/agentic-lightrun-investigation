# Public DNS name pointing to the VM. Do not include https:// or a path.
WEBHOOK_DOMAIN=jira-agent.example.com

# Docker Hub repository and immutable demo version published by the workstation.
JIRA_AGENT_IMAGE=your-dockerhub-user/jira-lightrun-agent
JIRA_AGENT_TAG=0.1.0

OPENAI_API_KEY=replace-me
LIGHTRUN_API_KEY=replace-me
GITHUB_MCP_PAT=replace-me

JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=agent-user@example.com
JIRA_API_TOKEN=replace-me

JIRA_TRIGGER_MODE=webhook
JIRA_WEBHOOK_SECRET=replace-with-output-of-openssl-rand-hex-32
JIRA_WEBHOOK_HOST=0.0.0.0
JIRA_WEBHOOK_PORT=8080

# Set the matching LangSmith variables instead if you want tracing.
LANGSMITH_TRACING=false
